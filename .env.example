# --------------------------------------------------------------
# Variables de entorno del proyecto
# Copia este archivo como .env y completa los valores reales.
# El archivo .env NO debe subirse a GitHub (está en .gitignore).
# --------------------------------------------------------------

# Rutas de datos (relativas a la raíz del proyecto)
RAW_DATA_PATH=data/raw/fraud_oracle.csv
PROCESSED_DATA_PATH=data/processed/fraud_clean.csv

# --------------------------------------------------------------
# MLflow — seguimiento de experimentos y Model Registry
# El backend debe ser una base de datos: el store de archivos no
# soporta el Model Registry.
# --------------------------------------------------------------
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=fraude-seguros-vehiculares
REGISTERED_MODEL_NAME=fraud-detection-classifier

# Solo en Windows: si la ruta del repositorio es profunda, los artefactos de
# MLflow superan el límite de 260 caracteres. Reubícalos a una ruta corta.
# MLFLOW_ARTIFACT_LOCATION=file:///C:/mlflow-fraude

# PR-AUC mínimo para promover un modelo a producción
MIN_PR_AUC=0.20

# --------------------------------------------------------------
# Optimización de hiperparámetros
# --------------------------------------------------------------
TUNING_ENABLED=true
TUNING_N_ITER=12
TUNING_CV_FOLDS=3

# --------------------------------------------------------------
# Servicio de predicción
# Carpeta local exportada, o referencia al registro:
#   MODEL_URI=models:/fraud-detection-classifier@champion
# --------------------------------------------------------------
MODEL_URI=models/champion

# Configuración de Streamlit (opcional)
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
